  "components": {
    "schemas": {
      "ComparisonPeer": {
        "type": "object",
        "required": [
          "peerCountryCode",
          "peerValue",
          "gap",
          "gapPct"
        ],
        "properties": {
          "gap": {
            "type": "number",
            "format": "double"
          },
          "gapPct": {
            "type": "number",
            "format": "double"
          },
          "peerCountryCode": {
            "type": "string"
          },
          "peerValue": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ComparisonResponse": {
        "type": "object",
        "required": [
          "country",
          "peers",
          "methodologyVersion",
          "rows",
          "comparisons"
        ],
        "properties": {
          "auPercentile": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "auRank": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "comparisons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComparisonPeer"
            }
          },
          "country": {
            "type": "string"
          },
          "methodologyVersion": {
            "type": "string"
          },
          "peers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComparisonRow"
            }
          }
        }
      },
      "ComparisonRow": {
        "type": "object",
        "required": [
          "countryCode",
          "date",
          "value",
          "rank"
        ],
        "properties": {
          "countryCode": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "methodologyVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "rank": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "value": {
            "type": "number",
            "format": "double"
          }
        }
      },
