      },
      "EnergyRetailAverageResponse": {
        "type": "object",
        "required": [
          "region",
          "customerType",
          "isModeled",
          "methodSummary",
          "sourceRefs",
          "freshness"
        ],
        "properties": {
          "annualBillAudMean": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "annualBillAudMedian": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "customerType": {
            "type": "string"
