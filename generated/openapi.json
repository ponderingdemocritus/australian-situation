          "sourceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            }
          },
          "window": {
            "type": "string"
          }
        }
      },
      "EnergyOverviewResponse": {
        "type": "object",
        "required": [
          "region",
          "methodSummary",
          "sourceRefs",
          "sourceMixViews",
          "panels",
          "freshness"
