          "isModeled": {
            "type": "boolean"
          },
          "methodSummary": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            }
          },
