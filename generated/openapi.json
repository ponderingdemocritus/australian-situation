          "methodSummary": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "rollups": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/WholesaleRollups"
              }
